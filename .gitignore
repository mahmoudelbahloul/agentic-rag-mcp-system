# ---------------------------------------------------------------
# Root .gitignore for the monorepo (applies to all sub-projects)
# ---------------------------------------------------------------

# Secrets / environment files — never commit real .env files
**/.env
**/.env.*
!**/.env.example

# Dependencies
**/node_modules/

# Build output / caches
**/dist/
**/dist-ssr/
**/build/
**/.vite/
**/coverage/
**/*.tsbuildinfo
**/*.local

# Logs
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS junk
.DS_Store
Thumbs.db
desktop.ini
